# Never commit the real .env.ovh file.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ENVIRONMENT=production
ALLOW_DEMO_DATA=False

ALLOWED_HOSTS=PIZZA_VITTI_OVH_HOSTNAME
PRIMARY_DOMAIN=PIZZA_VITTI_OVH_HOSTNAME
PRIMARY_SCHEME=https
SITE_URL=https://PIZZA_VITTI_OVH_HOSTNAME
CSRF_TRUSTED_ORIGINS=https://PIZZA_VITTI_OVH_HOSTNAME

POSTGRES_DB=pizza_vitti
POSTGRES_USER=pizza_vitti
POSTGRES_PASSWORD=replace-with-a-long-random-value

KITCHEN_PASSWORD=replace-with-a-strong-password
OWNER_DASHBOARD_USERNAME=admin
OWNER_DASHBOARD_PASSWORD_HASH=replace-with-a-django-pbkdf2-hash

# Optional service credentials. Keep these only on the VPS.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
